# ============================================================
# Rackvio Community Edition — settings
#
# Copy this file to .env, next to docker-compose.yml, and edit it.
# Everything in .env reaches Rackvio. After a change, run:
#   docker compose up -d
#
# Lines starting with # are off. To turn a setting on, remove the #.
# Keep comments on their own lines, not after a value.
# ============================================================

# --- Required -------------------------------------------------

# The first administrator's email address. Rackvio creates this account on
# the first start and prints a temporary password in the backend log.
PLATFORM_ADMIN_EMAIL=admin@yourcompany.com

# Signs sign-ins and the links Rackvio sends. Replace this example value
# with your own random secret, generated with:
#   openssl rand -hex 32
# Changing it later signs everyone out; set MFA_ENCRYPTION_KEY first if
# anyone uses two-factor authentication (see below).
AUTH_SECRET=change-me-generate-a-64-char-random-string

# --- Address and port -----------------------------------------

# Rackvio works at whatever address people open it at: the server's name or
# IP address, any port, or behind your own HTTPS reverse proxy. Sign-in
# follows the address in the browser; behind an HTTPS proxy, pass the
# X-Forwarded-Proto and X-Forwarded-Host headers so sign-in cookies are
# marked secure.
#
# RACKVIO_PUBLIC_URL is the address used in the links Rackvio emails
# (invitations, password resets) and prints from the command line. Set it
# to the address your users open, for example https://rackvio.example.com
RACKVIO_PUBLIC_URL=http://localhost:3000

# The port Rackvio listens on, on this server. The web app and the API
# (at /api) share it.
RACKVIO_PORT=3000

# Which release to run. "latest" follows every release; pin a version
# number such as 1.2.2 to upgrade on your own schedule.
RACKVIO_VERSION=latest

# --- Database passwords ---------------------------------------
# Set a different strong password for each one BEFORE the first start
# (the database accounts are created then), for example with:
#   openssl rand -base64 24 | tr -d '=+/'
DB_PASS=devpassword
APP_DB_PASS=devpassword
MIGRATIONS_DB_PASS=devpassword

# --- Email (invitations and password resets) ------------------
# Without SMTP_HOST Rackvio sends no email. An administrator can still copy
# an invitation or password-reset link in Admin > Users, or print one here:
#   docker compose exec backend rackvio admin invite-link someone@example.com
#   docker compose exec backend rackvio admin reset-link someone@example.com
#
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# STARTTLS on SMTP_PORT. Servers that only accept TLS from the first byte
# (usually port 465) are not supported.
# SMTP_USE_TLS=true
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=rackvio@example.com

# --- Two-factor authentication --------------------------------
# The key that protects two-factor secrets is derived from AUTH_SECRET.
# Before you change AUTH_SECRET, pin the current key here:
#   docker compose exec backend rackvio admin mfa-print-key
# MFA_ENCRYPTION_KEY=

# --- Floor-plan storage ---------------------------------------
# By default uploaded drawings are kept on the "uploads" Docker volume;
# back it up with the database. To keep them in Amazon S3 or an
# S3-compatible service instead (copy existing drawings first with
# `rackvio uploads migrate`, see the installation guide):
# STORAGE_BACKEND=s3
# S3_BUCKET=
# S3_REGION=us-east-1
# For an S3-compatible service; leave unset for Amazon S3.
# S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
